{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VocabularyImport",
  "description": "Array of words importable into one vocabulary. The vocabulary decides the words' language; translations are keyed by language code (de, en, fa). Import the same \"id\" again to update a word.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "wordType",
      "headword",
      "translations"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Optional stable id, e.g. 'b1-noun-abend'. Re-importing a word with the same id updates it instead of adding a duplicate."
      },
      "wordType": {
        "type": "string",
        "enum": [
          "noun",
          "verb",
          "adjective",
          "adverb",
          "preposition",
          "conjunction",
          "pronoun",
          "numeral",
          "phrase",
          "other"
        ]
      },
      "headword": {
        "type": "string",
        "description": "The word itself, without article, e.g. 'Abend' or 'anfangen'."
      },
      "translations": {
        "type": "object",
        "description": "Translations keyed by language code; at least one language other than the vocabulary's own.",
        "properties": {
          "de": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "en": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "fa": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "nounForms": {
        "type": "object",
        "description": "Optional. 'article' is only used for German (der/die/das).",
        "properties": {
          "article": {
            "type": [
              "string",
              "null"
            ],
            "description": "German: der, die or das"
          },
          "plural": {
            "type": [
              "string",
              "null"
            ],
            "description": "e.g. '-e', '¨-er', or full plural word"
          }
        }
      },
      "verbForms": {
        "type": "object",
        "description": "Required for German verbs, optional otherwise.",
        "properties": {
          "infinitive": {
            "type": "string"
          },
          "presentThirdPerson": {
            "type": "string",
            "description": "e.g. 'fängt an'"
          },
          "simplePast": {
            "type": "string",
            "description": "Präteritum, e.g. 'fing an'"
          },
          "perfect": {
            "type": "string",
            "description": "e.g. 'hat angefangen' or 'ist gefahren'"
          },
          "passive": {
            "type": [
              "string",
              "null"
            ],
            "description": "e.g. 'wird gemacht', null if not applicable"
          },
          "auxiliaryIsSein": {
            "type": "boolean"
          },
          "separable": {
            "type": "boolean"
          }
        },
        "required": [
          "infinitive",
          "presentThirdPerson",
          "simplePast",
          "perfect",
          "auxiliaryIsSein",
          "separable"
        ]
      },
      "sentences": {
        "type": "array",
        "maxItems": 10,
        "description": "Optional example sentences.",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "The sentence in the vocabulary's language"
            },
            "german": {
              "type": "string",
              "description": "Accepted as an alias of 'text' (v1 files)"
            },
            "translations": {
              "type": "object",
              "properties": {
                "de": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                },
                "fa": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "german"
              ]
            }
          ]
        }
      },
      "level": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2",
          null
        ]
      },
      "tags": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 40
        }
      },
      "regionalVariant": {
        "type": "string",
        "description": "Optional, e.g. 'CH' or 'A' for Swiss/Austrian standard variants."
      }
    }
  }
}
